{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/server/index.js" }
  ],
  "functions": {
    "server/index.js": {
      "memory": 256,
      "maxDuration": 10
    }
  }
}
